{
  "name": "smart-book-demo",
  "version": "0.2.0",
  "private": true,
  "homepage": "https://duynguyen2001.github.io/SmartBookDemo/",
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "test:unit": "vue-cli-service test:unit --coverage",
    "lint": "vue-cli-service lint",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@bananajs/vue2-book-component": "^0.2.3",
    "@vuesence/book": "^0.6.2",
    "ali-oss": "^6.18.1",
    "bootstrap": "^4.6.2",
    "bootstrap-vue": "^2.23.1",
    "chart.js": "^3.9.1",
    "core-js": "^3.35.0",
    "js-base64": "^3.7.5",
    "nouislider": "^15.7.1",
    "v-gallery": "^1.2.4",
    "vue": "^2.7.16",
    "vue-chartjs": "^4.1.2",
    "vue-clipboard2": "^0.3.3",
    "vue-router": "^3.6.5",
    "vue2-transitions": "^0.3.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.23.3",
    "@vue/cli-plugin-babel": "^5.0.8",
    "@vue/cli-plugin-eslint": "^5.0.8",
    "@vue/cli-plugin-unit-jest": "^5.0.8",
    "@vue/cli-service": "^5.0.8",
    "@vue/eslint-config-standard": "^8.0.1",
    "@vue/test-utils": "^1.3.6",
    "axios": "^1.6.2",
    "babel-jest": "^29.7.0",
    "element-ui": "^2.15.14",
    "eslint": "^8.55.0",
    "eslint-plugin-vue": "^9.18.1",
    "gh-pages": "^6.3.0",
    "sass": "^1.69.5",
    "sass-loader": "^13.3.2",
    "stylus": "^0.62.0",
    "stylus-loader": "^7.1.3",
    "vue-template-compiler": "^2.7.16"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "@vue/standard"
    ],
    "rules": {
      "eqeqeq": 0
    },
    "parserOptions": {
      "parser": "@babel/eslint-parser",
      "requireConfigFile": false
    },
    "overrides": [
      {
        "files": [
          "**/__tests__/*.{j,t}s?(x)"
        ],
        "env": {
          "jest": true
        }
      }
    ]
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "jest": {
    "moduleFileExtensions": [
      "js",
      "jsx",
      "json",
      "vue"
    ],
    "transform": {
      "^.+\\.vue$": "@vue/vue2-jest",
      ".+\\.(css|styl|less|sass|scss|svg|png|jpg|ttf|woff|woff2)$": "jest-transform-stub",
      "^.+\\.jsx?$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "snapshotSerializers": [
      "jest-serializer-vue"
    ],
    "testMatch": [
      "**/tests/unit/**/*.spec.(js|jsx|ts|tsx)|**/__tests__/*.(js|jsx|ts|tsx)"
    ],
    "testEnvironment": "jsdom",
    "watchPlugins": [
      "jest-watch-typeahead/filename",
      "jest-watch-typeahead/testname"
    ],
    "coverageDirectory": "<rootDir>/tests/unit/coverage",
    "collectCoverageFrom": [
      "src/**/*.{js,vue}",
      "!src/main.js",
      "!src/router.js",
      "!**/node_modules/**"
    ]
  }
}
